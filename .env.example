# Public environment variables (accessible in the browser)
NEXT_PUBLIC_HYPERLIQUID_NETWORK="mainnet" # "mainnet" or "testnet"
# Sibling deployments for the header network-switch button.
# Set both on both deployments; leave the counterpart empty to hide the button.
# AshDex deployments: https://ashdex.app (mainnet) / https://testnet.ashdex.app (testnet)
NEXT_PUBLIC_MAINNET_APP_URL=
NEXT_PUBLIC_TESTNET_APP_URL=
NEXT_PUBLIC_WALLET_CONNECT_ID=
NEXT_PUBLIC_BUILDER_RECEIVER_ADDRESS=
# Optional. Auto-applied via the agent wallet after agent approval. Empty/unset disables.
NEXT_PUBLIC_ASHDEX_REFERRAL_CODE=
# Optional. hl-tools app that manages multisig treasuries (treasury trading).
# Local: http://localhost:3000. Prod: https://hltools.tech. Empty/unset hides treasury links.
NEXT_PUBLIC_HLTOOLS_URL=
