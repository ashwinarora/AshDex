// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  wallet_id          String               @unique @db.VarChar(42)
  username           String               @unique @db.VarChar(50)
  avatar_url         Int?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  terms_signatures   UserTermsSignature[]
  invited_by         Int?
  is_nexon_referred  Boolean              @default(true)
  rewards_generated  Decimal              @default(0.0) @db.Decimal(10, 4)
  volume_traded      Decimal              @default(0.0) @db.Decimal(10, 4)
  rewards_updated_at DateTime?

  // Relations
  invites       Invite[]            @relation("InviteCodes")
  invite_used   Invite?             @relation("InvitedBy", fields: [invited_by], references: [id])
  reward_claims UserRewardsClaims[]

  @@map("users")
}

model UserRewardsClaims {
  id              Int      @id @default(autoincrement())
  user_id         Int
  rewards_claimed Decimal  @default(0.0) @db.Decimal(10, 4)
  created_at      DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("user_rewards_claims")
}

model Terms {
  id         Int                  @id @default(autoincrement())
  content    String               @db.Text
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  signatures UserTermsSignature[]
}

model UserTermsSignature {
  user_id   Int
  terms_id  Int
  signature String   @db.Text
  signed_at DateTime @default(now())

  User  User  @relation(fields: [user_id], references: [id])
  Terms Terms @relation(fields: [terms_id], references: [id])

  @@id([user_id, terms_id])
}

model Invite {
  id         Int      @id @default(autoincrement())
  user_id    Int
  code       String   @unique @db.VarChar(8)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  // Relations
  user    User   @relation("InviteCodes", fields: [user_id], references: [id], onDelete: Cascade)
  used_by User[] @relation("InvitedBy")

  @@index([user_id])
  @@map("invites")
}
